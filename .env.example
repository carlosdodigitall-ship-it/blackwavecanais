# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# META PIXEL: ID do Pixel da Meta para tracking de anúncios (Facebook / Instagram Ads)
# Exemplo: 123456789012345
VITE_META_PIXEL_ID=

# GOOGLE ANALYTICS: ID de Medição do GA4
# Exemplo: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# VÍDEO: URL direta do vídeo (MP4 ou URL compatível) para a seção de apresentação
# Deixe vazio para exibir o placeholder cinematográfico
VITE_VIDEO_URL=
